# Required for OAuth (multi-tenant)
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
STATE_SECRET=your-random-state-secret

# Required
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# Optional: AES-256 key for encrypting stored tokens (64 hex chars / 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# Optional: custom OAuth redirect URI (defaults to https://localhost:3000/slack/oauth_redirect)
# OAUTH_REDIRECT_URI=https://your-domain.com/slack/oauth_redirect

# Legacy: single-workspace mode (auto-migrated to SQLite on first boot)
# SLACK_BOT_TOKEN=xoxb-your-bot-token

# For programmatic app management (setup/update scripts)
SLACK_CONFIG_TOKEN=xoxe-your-config-token
SLACK_CONFIG_REFRESH_TOKEN=xoxe-your-refresh-token
